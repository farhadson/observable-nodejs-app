              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 200/201', function () {",
                    "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "",
                    "let j = {};",
                    "try { j = pm.response.json(); } catch (e) {}",
                    "",
                    "const id = j?.id ?? j?.data?.id ?? j?.user?.id ?? j?.data?.user?.id;",
                    "if (id) pm.collectionVariables.set('flowUserId', String(id));",
                    "",
                    "pm.test('flowUserId was captured (adjust parsing if your API differs)', function () {",
                    "  pm.expect(pm.collectionVariables.get('flowUserId')).to.not.be.empty;",
                    "});"
                  ]
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{flowEmail}}\",\n  \"password\": \"{{flowPassword}}\",\n  \"name\": \"{{flowName}}\"\n}"
              },
