                  "type": "text/javascript",
                  "exec": [
                    "// Create a unique email once per run for the flow user",
                    "if (!pm.collectionVariables.get('flowEmail')) {",
                    "  const uuid = pm.variables.replaceIn('{{$randomUUID}}');",
                    "  pm.collectionVariables.set('flowEmail', `alice-${uuid}@example.com`);",
                    "}"
                  ]
